# Cloudflare Workers static assets: response headers (copied into dist/ by tools/build_web.sh)
# No 'unsafe-eval': the app never uses Dioxus `document::eval`; Rust calls the sync/keys scripts (static <head>)
# through Reflect (src/js_bridge.rs). 'wasm-unsafe-eval' is only for compiling the wasm module.
# blob: in script-src: the mic AudioWorklet is loaded from a Blob URL (src/mic/web.rs).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin

# dx content-hashes every file under /assets/, so a name never changes meaning
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts (public/fonts) are not hashed: cache long, but revalidate after a week
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
